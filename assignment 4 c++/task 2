#include <iostream>
#include <string>
using namespace std;

class Person {
public:
    string name;
    int id;
    string phone;

    Person(string n, int i, string p)
        : name(n), id(i), phone(p) {}
};

class Student : virtual public Person {
public:
    string programme;
    double cgpa;

    Student(string n, int i, string p, string pr, double c)
        : Person(n, i, p), programme(pr), cgpa(c) {}
};

class Staff : virtual public Person {
public:
    string department;
    double salary;

    Staff(string n, int i, string p, string d, double s)
        : Person(n, i, p), department(d), salary(s) {}
};

class TeachingAssistant : public Student, public Staff {
public:
    TeachingAssistant(string n, int i, string p,
                      string pr, double c,
                      string d, double s)
        : Person(n, i, p),
          Student(n, i, p, pr, c),
          Staff(n, i, p, d, s) {}

    void display() {
        cout << "Name: " << name << endl;
        cout << "ID: " << id << endl;
        cout << "Phone: " << phone << endl;
        cout << "Programme: " << programme << endl;
        cout << "CGPA: " << cgpa << endl;
        cout << "Department: " << department << endl;
        cout << "Salary: " << salary << endl;
    }
};

class ResearchScholar : public Student {
public:
    double fellowship;

    ResearchScholar(string n, int i, string p,
                    string pr, double c, double f)
        : Person(n, i, p),
          Student(n, i, p, pr, c),
          fellowship(f) {}
};

int main() {
    TeachingAssistant ta("Kavya", 101, "9876543210",
                         "AI&DS", 8.5, "CSE", 30000);

    cout << "Teaching Assistant Details" << endl;
    ta.display();

    ResearchScholar rs("Arun", 102, "9876543211",
                       "AI&DS", 9.0, 15000);

    cout << "\nResearch Scholar Details" << endl;
    cout << rs.name << endl;
    cout << rs.fellowship << endl;

    return 0;
}
